---
// Portada de una colección: siempre a pantalla completa, sea cual sea la pantalla.
// Dos formatos (se elige en src/data/collections.ts → hero):
//  · video  → vídeo en bucle de fondo
//  · scroll → al hacer scroll, cada foto sube y cubre a la anterior
import type { Collection } from '../data/collections';

interface Props {
  collection: Collection;
}
const { collection: c } = Astro.props;
const hero = c.hero;
---

{hero.type === 'video' ? (
  <section class="chero chero--video" aria-label={`Portada de ${c.name}`}>
    <div class="chero__ph">Vídeo de la colección · public{hero.src}</div>
    <video
      class="chero__media"
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      poster={hero.poster}
      data-chero-video
      data-src={hero.src}
      data-src-mobile={hero.srcMobile ?? hero.src}
    ></video>
    <div class="chero__shade"></div>
    <div class="chero__title">
      <p class="eyebrow">{c.season}</p>
      <h1 class="display">{c.name}</h1>
    </div>
    <span class="chero__cue">Scroll ↓</span>
  </section>
) : (
  <section class="chero chero--scroll" style={`--n:${hero.slides.length}`} aria-label={`Portada de ${c.name}`} data-chero-scroll>
    <div class="chero__stage">
      {hero.slides.map((s) => (
        <div class="chero__slide" data-slide style={`--tone:${s.tone ?? c.tone}`}>
          <div class="chero__slide-in">
            {s.src && <img src={s.src} alt={s.alt ?? ''} />}
          </div>
        </div>
      ))}
      <div class="chero__shade"></div>
      <div class="chero__title">
        <p class="eyebrow">{c.season}</p>
        <h1 class="display">{c.name}</h1>
      </div>
      <span class="chero__cue">Scroll ↓</span>
    </div>
  </section>
)}

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Vídeo: vertical en pantallas más altas que anchas, horizontal en el resto
  document.querySelectorAll<HTMLVideoElement>('[data-chero-video]').forEach((v) => {
    const portrait = matchMedia('(max-aspect-ratio: 1/1)');
    const set = () => {
      v.src = portrait.matches ? v.dataset.srcMobile! : v.dataset.src!;
      v.load();
      if (!reduce) v.play().catch(() => {});
    };
    set();
    portrait.addEventListener('change', set);
  });

  // Scroll: la posición de la página decide cuánto "sube" cada foto
  document.querySelectorAll<HTMLElement>('[data-chero-scroll]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const n = slides.length;
    if (reduce || n < 2) return;

    const update = () => {
      const rect = root.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -rect.top / total));
      const x = p * (n - 1);
      slides.forEach((s, k) => {
        if (k === 0) return;
        const v = Math.min(1, Math.max(0, x - (k - 1)));
        s.style.clipPath = `inset(${(1 - v) * 100}% 0 0 0)`;
        (s.firstElementChild as HTMLElement).style.transform = `scale(${1.18 - 0.18 * v})`;
      });
    };

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  });
</script>
