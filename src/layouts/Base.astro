---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const {
  title,
  description = 'DELTELL — diseñadora emergente. Colecciones, desfiles y piezas a medida.',
  home = false,
} = Astro.props;
const fullTitle = title ? `${title} — DELTELL` : 'DELTELL';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <script is:inline define:vars={{ home }}>
      // Antes del primer pintado: marca JS activo y decide si suena la intro.
      var d = document.documentElement;
      d.classList.add('js');
      try {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var forced = location.search.indexOf('intro') > -1; // ?intro fuerza la intro
        var seen = sessionStorage.getItem('deltell-intro') === '1';
        if (home && !reduce && (forced || !seen)) {
          d.classList.add('intro');
          // Seguridad: si el JS de la intro no arranca, no dejamos la pantalla en blanco
          window.__introTimer = setTimeout(function () { d.classList.remove('intro'); }, 5000);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    {home && <div class="intro-overlay" data-intro-overlay aria-hidden="true"></div>}
    <Header home={home} />
    <slot />
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
